<%= tag.div(**root_attrs("divide-y divide-[hsl(var(--senren-border))] rounded-(--senren-radius) border border-[hsl(var(--senren-border))] bg-[hsl(var(--senren-background))]", data: { controller: "senren--accordion", "senren--accordion-multiple-value": multiple? })) do %>
  <% items.each_with_index do |item, index| %>
    <% expanded = open_item?(item, index) %>
    <section>
      <h3>
        <button type="button" class="group flex w-full cursor-pointer items-center justify-between gap-4 px-4 py-3 text-left text-sm font-medium text-[hsl(var(--senren-foreground))] transition-colors hover:bg-[hsl(var(--senren-muted)/0.5)]" aria-expanded="<%= expanded %>" aria-controls="<%= item[:id] %>-panel" data-senren--accordion-target="trigger" data-panel-id="<%= item[:id] %>" data-action="click->senren--accordion#toggle">
          <span><%= item[:title] %></span>
          <%# Rotation is driven by aria-expanded, which the controller already %>
          <%# maintains, so the icon cannot drift out of step with the state a %>
          <%# screen reader is being told. A "+" was here before -- readable, but %>
          <%# static, and it gave no hint that the panel animates. %>
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0 text-[hsl(var(--senren-muted-foreground))] transition-transform duration-200 group-aria-expanded:rotate-180">
            <path d="m5 8 5 5 5-5"></path>
          </svg>
        </button>
      </h3>
      <%# The grid wrapper is what animates. A height transition needs a number %>
      <%# to count to, and the content's height is not known until it is laid %>
      <%# out; `grid-template-rows: 0fr -> 1fr` animates to the content's own %>
      <%# height without measuring it in JavaScript. %>
      <%# The `hidden` attribute stays, because content that is visually %>
      <%# collapsed but present is still focusable and still read aloud. The %>
      <%# controller removes it before opening and restores it after the close %>
      <%# transition ends, so the animation never costs the semantics. %>
      <div id="<%= item[:id] %>-panel" data-senren--accordion-target="panel" data-panel-id="<%= item[:id] %>" <% unless expanded %>hidden<% end %> class="grid transition-[grid-template-rows] duration-200 ease-out <%= expanded ? 'grid-rows-[1fr]' : 'grid-rows-[0fr]' %>">
        <div class="overflow-hidden">
          <div class="px-4 pb-4 text-sm leading-6 text-[hsl(var(--senren-muted-foreground))]">
            <%= item[:content].presence || content %>
          </div>
        </div>
      </div>
    </section>
  <% end %>
<% end %>
