#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

echo "==> CI step: tests"
bin/test

echo "==> CI step: system tests"
bin/system

echo "==> CI step: RuboCop"
bundle exec rubocop --cache false

echo "==> CI step: JavaScript checks"
bun run controllers:check

echo "==> CI step: performance checks"
bin/performance

echo "==> CI passed"
